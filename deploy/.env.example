# Produção: copie para deploy/.env na VPS e preencha. O .env nunca vai para o Git
# (chmod 600, dono = usuário do deploy). Comandos de geração no deploy/README.md.
# Senhas do banco entram em URLs: use só caracteres hexadecimais (openssl rand -hex 32).

# Domínio da plataforma (sem https://) e e-mail para o Let's Encrypt
APP_DOMAIN=
ACME_EMAIL=

# Imagens publicadas pelo CI: ghcr.io/<dono-em-minúsculas>/tanaregua
IMAGE_PREFIX=ghcr.io/willyrenzo/tanaregua

# Banco: dono das tabelas (migrations e backup) e usuário da aplicação (sujeito ao RLS).
# APP_DB_PASSWORD só é aplicada na criação do volume do Postgres.
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=

# Segredos da API (ver backend/.env.example)
JWT_ACCESS_SECRET=
INTERNAL_API_TOKEN=
# Estável: trocar exige que as barbearias reconectem o WhatsApp
SECRETS_ENCRYPTION_KEY=

# E-mail (Resend com domínio verificado)
MAIL_PROVIDER=resend
MAIL_FROM=TaNaRegua <nao-responda@seu-dominio>
RESEND_API_KEY=

# WhatsApp (Cloud API da Meta; cada barbearia conecta a própria conta no painel)
WHATSAPP_PROVIDER=meta
META_GRAPH_API_VERSION=v23.0

LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Backup diário criptografado, fora da VPS (qualquer storage S3-compatível)
# Chave PÚBLICA age (age1...); a privada fica guardada fora da VPS.
BACKUP_AGE_RECIPIENT=
# bucket/pasta no storage
BACKUP_DESTINATION=
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_HOUR_UTC=6
BACKUP_RETENTION_DAYS=30
