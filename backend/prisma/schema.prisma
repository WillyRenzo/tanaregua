// Convenções (ver .claude/rules/database.md):
// - Tabelas com tenant têm barbershop_id + policy RLS criada em SQL manual na migration.
// - Dinheiro em centavos (Int); percentuais em basis points (Int, 10000 = 100%).
// - Datas em timestamptz; IDs UUID v7.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identidade e tenancy ─────────────

/// Tenant. Sem RLS: é lido pelo slug nas rotas públicas e no login.
model Barbershop {
  id                           String   @id @default(uuid(7)) @db.Uuid
  name                         String
  slug                         String   @unique
  timezone                     String   @default("America/Sao_Paulo")
  /// Antecedência mínima para o cliente cancelar online (business-rules §2).
  cancellationMinNoticeMinutes Int      @default(120) @map("cancellation_min_notice_minutes")
  /// Antecedência mínima para o cliente reagendar online (business-rules §2).
  rescheduleMinNoticeMinutes   Int      @default(1440) @map("reschedule_min_notice_minutes")
  /// Intervalo obrigatório entre atendimentos do mesmo profissional.
  bufferMinutes                Int      @default(0) @map("buffer_minutes")
  /// Identidade visual (business-rules §10): cores em hex minúsculo (#rrggbb).
  brandPrimaryColor            String?  @map("brand_primary_color")
  brandSecondaryColor          String?  @map("brand_secondary_color")
  /// Chave do logo no ObjectStorage (nome gerado pelo sistema, nunca vindo do usuário).
  logoKey                      String?  @map("logo_key")
  /// Mensagem automática de aniversário (business-rules §9): só para quem consentiu no canal.
  birthdayMessagesEnabled      Boolean  @default(false) @map("birthday_messages_enabled")
  /// Texto do e-mail de aniversário ({nome}, {barbearia}); null = texto padrão.
  birthdayEmailText            String?  @map("birthday_email_text")
  /// Modelo aprovado do WhatsApp para o aniversário ({ name, language, parameters }); null = só e-mail.
  birthdayWhatsappTemplate     Json?    @map("birthday_whatsapp_template")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles              Role[]
  clients            Client[]
  services           Service[]
  products           Product[]
  packages           ServicePackage[]
  memberships        Membership[]
  whatsappConnection WhatsAppConnection?
  campaigns          Campaign[]
  subscription       Subscription?

  @@map("barbershops")
}

/// Identidade global de login. Sem RLS: acessada só pelo módulo auth.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Sempre normalizado em minúsculas pela aplicação.
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Papel = conjunto de permissões, por barbearia. Novos papéis não exigem código.
model Role {
  id           String   @id @default(uuid(7)) @db.Uuid
  barbershopId String   @map("barbershop_id") @db.Uuid
  /// Identificador estável (owner, professional, receptionist, client ou customizado).
  key          String
  name         String
  /// Papéis padrão criados no cadastro da barbearia; não podem ser apagados.
  isSystem     Boolean  @default(false) @map("is_system")
  /// Códigos do catálogo em src/modules/auth/permissions.ts.
  permissions  String[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  barbershop  Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([barbershopId, key])
  @@map("roles")
}

/// Vínculo usuário ↔ barbearia ↔ papel. Funcionários e clientes com conta.
model Membership {
  id             String   @id @default(uuid(7)) @db.Uuid
  barbershopId   String   @map("barbershop_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  /// Aparece como coluna na agenda (o dono também pode atender).
  isProfessional Boolean  @default(false) @map("is_professional")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              Role              @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  workSchedules     WorkSchedule[]
  appointments      Appointment[]
  orderItems        OrderItem[]
  commissionEntries CommissionEntry[]
  timeOffs          TimeOff[]
  commissionRules   CommissionRule[]

  /// Alvo das FKs compostas (barbershop_id, membership_id): garante mesmo tenant no banco.
  @@unique([barbershopId, id], map: "memberships_tenant_id_key")
  @@unique([barbershopId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Refresh token opaco, guardado só como hash. Sem RLS: pertence ao usuário.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  /// Todos os tokens de uma mesma sessão; reuso de um token revoga a família inteira.
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

// ───────────── Equipe ─────────────

/// Expediente semanal no fuso da barbearia. Vários intervalos por dia (ex.: pausa do almoço).
model WorkSchedule {
  id           String @id @default(uuid(7)) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  /// 0 = domingo … 6 = sábado
  weekday      Int
  /// Minutos desde a meia-noite (horário local da barbearia).
  startMinute  Int    @map("start_minute")
  endMinute    Int    @map("end_minute")

  membership Membership @relation(fields: [barbershopId, membershipId], references: [barbershopId, id], onDelete: Cascade, map: "work_schedules_tenant_membership_fkey")

  @@index([barbershopId, membershipId])
  @@map("work_schedules")
}

/// Folga, férias ou bloqueio pontual de agenda.
model TimeOff {
  id           String   @id @default(uuid(7)) @db.Uuid
  barbershopId String   @map("barbershop_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  startsAt     DateTime @map("starts_at") @db.Timestamptz
  endsAt       DateTime @map("ends_at") @db.Timestamptz
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  membership Membership @relation(fields: [barbershopId, membershipId], references: [barbershopId, id], onDelete: Cascade, map: "time_offs_tenant_membership_fkey")

  @@index([barbershopId, membershipId, startsAt])
  @@map("time_offs")
}

// ───────────── Clientes (PII — business-rules §9) ─────────────

/// Cadastro de cliente por barbearia. Classificação de dados (AFA 20) nos comentários:
/// P2 = dado pessoal identificável (mascarar em logs).
model Client {
  id                String    @id @default(uuid(7)) @db.Uuid
  barbershopId      String    @map("barbershop_id") @db.Uuid
  /// Conta de login do cliente (agendamento online), quando existir.
  userId            String?   @map("user_id") @db.Uuid
  /// P2
  name              String
  /// P2 — só dígitos, com DDI (ex.: 5511999998888)
  phone             String?
  /// P2
  email             String?
  /// P2
  birthDate         DateTime? @map("birth_date") @db.Date
  /// Consentimento para aniversário e marketing, por canal (business-rules §9): data da concessão.
  emailConsentAt    DateTime? @map("email_consent_at") @db.Timestamptz
  whatsappConsentAt DateTime? @map("whatsapp_consent_at") @db.Timestamptz
  notes             String?
  anonymizedAt      DateTime? @map("anonymized_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  barbershop        Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade, map: "clients_barbershop_fkey")
  appointments      Appointment[]
  orders            Order[]
  packages          ClientPackage[]
  marketingMessages MarketingMessage[]

  @@unique([barbershopId, id], map: "clients_tenant_id_key")
  @@unique([barbershopId, userId])
  @@index([barbershopId, name])
  @@map("clients")
}

// ───────────── Catálogo ─────────────

model Service {
  id              String   @id @default(uuid(7)) @db.Uuid
  barbershopId    String   @map("barbershop_id") @db.Uuid
  name            String
  description     String?
  priceCents      Int      @map("price_cents")
  durationMinutes Int      @map("duration_minutes")
  /// Inativo some do agendamento, mas continua no histórico (sem DELETE).
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  barbershop       Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade, map: "services_barbershop_fkey")
  appointmentItems AppointmentItem[]
  orderItems       OrderItem[]
  commissionRules  CommissionRule[]
  packageItems     ServicePackageItem[]
  packageBalances  ClientPackageBalance[]

  @@unique([barbershopId, id], map: "services_tenant_id_key")
  @@index([barbershopId, active])
  @@map("services")
}

enum CommissionType {
  PERCENT
  FIXED
}

/// Precedência (business-rules §4): funcionário+serviço > serviço > funcionário.
model CommissionRule {
  id           String         @id @default(uuid(7)) @db.Uuid
  barbershopId String         @map("barbershop_id") @db.Uuid
  membershipId String?        @map("membership_id") @db.Uuid
  serviceId    String?        @map("service_id") @db.Uuid
  productId    String?        @map("product_id") @db.Uuid
  type         CommissionType
  /// PERCENT: basis points (4000 = 40%). FIXED: centavos.
  value        Int
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  membership Membership? @relation(fields: [barbershopId, membershipId], references: [barbershopId, id], onDelete: Cascade, map: "commission_rules_tenant_membership_fkey")
  service    Service?    @relation(fields: [barbershopId, serviceId], references: [barbershopId, id], onDelete: Cascade, map: "commission_rules_tenant_service_fkey")
  product    Product?    @relation(fields: [barbershopId, productId], references: [barbershopId, id], onDelete: Cascade, map: "commission_rules_tenant_product_fkey")

  /// Criado com NULLS NOT DISTINCT na migration (NULL = "qualquer"), que o Prisma não expressa.
  @@unique([barbershopId, membershipId, serviceId, productId], map: "commission_rules_target_key")
  @@index([barbershopId])
  @@map("commission_rules")
}

// ───────────── Estoque e produtos (business-rules §7) ─────────────

/// Produto vendido na comanda. `stockQuantity` é mantido só pelo trigger das movimentações
/// (o usuário da aplicação não tem UPDATE nessa coluna) e nunca fica negativo (CHECK).
model Product {
  id               String   @id @default(uuid(7)) @db.Uuid
  barbershopId     String   @map("barbershop_id") @db.Uuid
  name             String
  description      String?
  priceCents       Int      @map("price_cents")
  /// Custo de referência por unidade (o da última entrada); valoriza vendas e ajustes.
  costCents        Int      @default(0) @map("cost_cents")
  stockQuantity    Int      @default(0) @map("stock_quantity")
  /// Abaixo disso o produto aparece como "repor estoque". Null = sem alerta.
  minStockQuantity Int?     @map("min_stock_quantity")
  /// Inativo some da venda, mas continua no histórico (sem DELETE).
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  barbershop      Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade, map: "products_barbershop_fkey")
  movements       StockMovement[]
  orderItems      OrderItem[]
  commissionRules CommissionRule[]

  @@unique([barbershopId, id], map: "products_tenant_id_key")
  @@index([barbershopId, active])
  @@map("products")
}

enum StockMovementKind {
  ENTRY
  SALE
  SALE_REVERSAL
  ADJUSTMENT
}

/// Histórico de estoque, append-only: entrada (+), venda (−), estorno de venda (+), ajuste (±).
/// O saldo do produto é a soma destas linhas (aplicada por trigger).
model StockMovement {
  id            String            @id @default(uuid(7)) @db.Uuid
  barbershopId  String            @map("barbershop_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  kind          StockMovementKind
  /// Delta com sinal.
  quantity      Int
  /// Custo por unidade (pago na entrada; o de referência nas demais). Valoriza o estoque.
  unitCostCents Int               @map("unit_cost_cents")
  reason        String?
  orderId       String?           @map("order_id") @db.Uuid
  authorUserId  String            @map("author_user_id") @db.Uuid
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz

  product Product @relation(fields: [barbershopId, productId], references: [barbershopId, id], map: "stock_movements_tenant_product_fkey")
  order   Order?  @relation(fields: [barbershopId, orderId], references: [barbershopId, id], map: "stock_movements_tenant_order_fkey")

  @@index([barbershopId, productId, occurredAt])
  @@map("stock_movements")
}

// ───────────── Pacotes de serviços (business-rules §6) ─────────────

/// Pacote à venda: N sessões por serviço, preço e validade em dias a partir da compra.
model ServicePackage {
  id                   String   @id @default(uuid(7)) @db.Uuid
  barbershopId         String   @map("barbershop_id") @db.Uuid
  name                 String
  description          String?
  priceCents           Int      @map("price_cents")
  validityDays         Int      @map("validity_days")
  /// Sessão usada gera comissão para quem atendeu (sobre o valor da sessão). Desligável.
  commissionOnSessions Boolean  @default(true) @map("commission_on_sessions")
  /// Inativo some da venda; pacotes já vendidos continuam valendo.
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  barbershop     Barbershop           @relation(fields: [barbershopId], references: [id], onDelete: Cascade, map: "service_packages_barbershop_fkey")
  items          ServicePackageItem[]
  orderItems     OrderItem[]
  clientPackages ClientPackage[]

  @@unique([barbershopId, id], map: "service_packages_tenant_id_key")
  @@index([barbershopId, active])
  @@map("service_packages")
}

model ServicePackageItem {
  id           String @id @default(uuid(7)) @db.Uuid
  barbershopId String @map("barbershop_id") @db.Uuid
  packageId    String @map("package_id") @db.Uuid
  serviceId    String @map("service_id") @db.Uuid
  quantity     Int

  package ServicePackage @relation(fields: [barbershopId, packageId], references: [barbershopId, id], onDelete: Cascade, map: "service_package_items_tenant_package_fkey")
  service Service        @relation(fields: [barbershopId, serviceId], references: [barbershopId, id], map: "service_package_items_tenant_service_fkey")

  @@unique([barbershopId, packageId, serviceId], map: "service_package_items_service_key")
  @@map("service_package_items")
}

enum ClientPackageStatus {
  ACTIVE
  REFUNDED
  VOIDED
}

/// Pacote comprado (snapshot do modelo na compra). Intransferível: preso ao cliente.
/// Vencido = ACTIVE com expiresAt no passado (derivado, sem job).
model ClientPackage {
  id                   String              @id @default(uuid(7)) @db.Uuid
  barbershopId         String              @map("barbershop_id") @db.Uuid
  clientId             String              @map("client_id") @db.Uuid
  packageId            String              @map("package_id") @db.Uuid
  /// Comanda em que foi vendido (e pago).
  orderId              String              @map("order_id") @db.Uuid
  name                 String
  pricePaidCents       Int                 @map("price_paid_cents")
  commissionOnSessions Boolean             @map("commission_on_sessions")
  purchasedAt          DateTime            @map("purchased_at") @db.Timestamptz
  expiresAt            DateTime            @map("expires_at") @db.Timestamptz
  status               ClientPackageStatus @default(ACTIVE)
  refundedAt           DateTime?           @map("refunded_at") @db.Timestamptz
  refundCents          Int?                @map("refund_cents")
  refundReason         String?             @map("refund_reason")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz

  client     Client                 @relation(fields: [barbershopId, clientId], references: [barbershopId, id], map: "client_packages_tenant_client_fkey")
  package    ServicePackage         @relation(fields: [barbershopId, packageId], references: [barbershopId, id], map: "client_packages_tenant_package_fkey")
  order      Order                  @relation(fields: [barbershopId, orderId], references: [barbershopId, id], map: "client_packages_tenant_order_fkey")
  balances   ClientPackageBalance[]
  movements  PackageMovement[]
  orderItems OrderItem[]

  @@unique([barbershopId, id], map: "client_packages_tenant_id_key")
  @@index([barbershopId, clientId])
  @@map("client_packages")
}

/// Saldo de sessões por serviço. `remaining` só muda pelo trigger das movimentações
/// (o usuário da aplicação não tem UPDATE nela) e nunca fica negativo (CHECK).
model ClientPackageBalance {
  id                String @id @default(uuid(7)) @db.Uuid
  barbershopId      String @map("barbershop_id") @db.Uuid
  clientPackageId   String @map("client_package_id") @db.Uuid
  serviceId         String @map("service_id") @db.Uuid
  initialQuantity   Int    @map("initial_quantity")
  remaining         Int    @default(0)
  /// Valor de uma sessão deste serviço no pacote (base da comissão quando usada).
  sessionValueCents Int    @map("session_value_cents")

  clientPackage ClientPackage @relation(fields: [barbershopId, clientPackageId], references: [barbershopId, id], map: "client_package_balances_tenant_package_fkey")
  service       Service       @relation(fields: [barbershopId, serviceId], references: [barbershopId, id], map: "client_package_balances_tenant_service_fkey")

  @@unique([barbershopId, clientPackageId, serviceId], map: "client_package_balances_service_key")
  @@map("client_package_balances")
}

enum PackageMovementKind {
  PURCHASE
  USE
  USE_REVERSAL
}

/// Histórico de sessões, append-only: compra (+), uso (−), devolução por estorno (+).
model PackageMovement {
  id              String              @id @default(uuid(7)) @db.Uuid
  barbershopId    String              @map("barbershop_id") @db.Uuid
  clientPackageId String              @map("client_package_id") @db.Uuid
  serviceId       String              @map("service_id") @db.Uuid
  kind            PackageMovementKind
  /// Delta com sinal.
  quantity        Int
  orderId         String              @map("order_id") @db.Uuid
  authorUserId    String              @map("author_user_id") @db.Uuid
  occurredAt      DateTime            @default(now()) @map("occurred_at") @db.Timestamptz

  clientPackage ClientPackage @relation(fields: [barbershopId, clientPackageId], references: [barbershopId, id], map: "package_movements_tenant_package_fkey")
  order         Order         @relation(fields: [barbershopId, orderId], references: [barbershopId, id], map: "package_movements_tenant_order_fkey")

  @@index([barbershopId, clientPackageId])
  @@index([barbershopId, orderId])
  @@map("package_movements")
}

// ───────────── Agenda ─────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  PANEL
  ONLINE
}

/// Regra mais crítica do sistema (business-rules §2): exclusion constraint na migration
/// impede dois atendimentos ativos sobrepostos para o mesmo profissional.
model Appointment {
  id                  String            @id @default(uuid(7)) @db.Uuid
  barbershopId        String            @map("barbershop_id") @db.Uuid
  professionalId      String            @map("professional_id") @db.Uuid
  clientId            String            @map("client_id") @db.Uuid
  startsAt            DateTime          @map("starts_at") @db.Timestamptz
  endsAt              DateTime          @map("ends_at") @db.Timestamptz
  /// endsAt + buffer da barbearia no momento do agendamento; é o que a constraint compara.
  blockedUntil        DateTime          @map("blocked_until") @db.Timestamptz
  status              AppointmentStatus @default(SCHEDULED)
  source              AppointmentSource
  notes               String?
  cancellationReason  String?           @map("cancellation_reason")
  /// Justificativa da falta, registrada pela equipe. Nunca aparece para o cliente.
  noShowJustification String?           @map("no_show_justification")
  createdByUserId     String            @map("created_by_user_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  professional Membership        @relation(fields: [barbershopId, professionalId], references: [barbershopId, id], map: "appointments_tenant_professional_fkey")
  client       Client            @relation(fields: [barbershopId, clientId], references: [barbershopId, id], map: "appointments_tenant_client_fkey")
  items        AppointmentItem[]
  order        Order?

  @@unique([barbershopId, id], map: "appointments_tenant_id_key")
  @@index([barbershopId, startsAt])
  @@index([barbershopId, clientId])
  @@map("appointments")
}

/// Serviços do agendamento com snapshot de nome, preço e duração.
model AppointmentItem {
  id              String @id @default(uuid(7)) @db.Uuid
  barbershopId    String @map("barbershop_id") @db.Uuid
  appointmentId   String @map("appointment_id") @db.Uuid
  serviceId       String @map("service_id") @db.Uuid
  position        Int
  name            String
  priceCents      Int    @map("price_cents")
  durationMinutes Int    @map("duration_minutes")

  appointment Appointment @relation(fields: [barbershopId, appointmentId], references: [barbershopId, id], onDelete: Cascade, map: "appointment_items_tenant_appointment_fkey")
  service     Service     @relation(fields: [barbershopId, serviceId], references: [barbershopId, id], map: "appointment_items_tenant_service_fkey")

  @@index([barbershopId, appointmentId])
  @@map("appointment_items")
}

// ───────────── Idempotência ─────────────

/// Respostas de POSTs sensíveis (Idempotency-Key). Escopo = usuário; sem RLS.
model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  key          String
  requestHash  String   @map("request_hash")
  /// null enquanto a requisição original ainda está em processamento.
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ───────────── Outbox (AFA 12) ─────────────

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/// Eventos de domínio gravados na MESMA transação da mudança e despachados por um worker
/// (evita dual-write). Tabela de sistema, sem RLS: o payload só carrega IDs, nunca PII.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  barbershopId  String       @map("barbershop_id") @db.Uuid
  /// Nome no passado: AppointmentBooked, AppointmentCancelled…
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

// ───────────── Comanda e financeiro (business-rules §3 e §4) ─────────────

enum OrderStatus {
  OPEN
  CLOSED
  VOIDED
}

enum PaymentMethod {
  CASH
  PIX
  CARD_CREDIT
  CARD_DEBIT
  OTHER
}

/// Comanda: fonte da verdade do financeiro. Fechada é imutável (trigger na migration);
/// correção só por estorno (VOIDED + lançamentos inversos).
model Order {
  id             String         @id @default(uuid(7)) @db.Uuid
  barbershopId   String         @map("barbershop_id") @db.Uuid
  clientId       String?        @map("client_id") @db.Uuid
  /// Uma comanda por agendamento.
  appointmentId  String?        @map("appointment_id") @db.Uuid
  status         OrderStatus    @default(OPEN)
  paymentMethod  PaymentMethod? @map("payment_method")
  /// Gravado no fechamento.
  totalCents     Int?           @map("total_cents")
  openedByUserId String         @map("opened_by_user_id") @db.Uuid
  closedByUserId String?        @map("closed_by_user_id") @db.Uuid
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz
  voidedAt       DateTime?      @map("voided_at") @db.Timestamptz
  voidReason     String?        @map("void_reason")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  client            Client?           @relation(fields: [barbershopId, clientId], references: [barbershopId, id], map: "orders_tenant_client_fkey")
  appointment       Appointment?      @relation(fields: [barbershopId, appointmentId], references: [barbershopId, id], map: "orders_tenant_appointment_fkey")
  items             OrderItem[]
  commissionEntries CommissionEntry[]
  cashEntries       CashEntry[]
  stockMovements    StockMovement[]
  packageMovements  PackageMovement[]
  packagesSold      ClientPackage[]

  @@unique([barbershopId, id], map: "orders_tenant_id_key")
  @@unique([barbershopId, appointmentId], map: "orders_appointment_key")
  @@index([barbershopId, status])
  @@index([barbershopId, closedAt])
  @@map("orders")
}

/// Item da comanda com snapshot do preço; a regra de comissão é congelada no fechamento.
enum OrderItemKind {
  SERVICE
  PRODUCT
  PACKAGE
}

model OrderItem {
  id                       String          @id @default(uuid(7)) @db.Uuid
  barbershopId             String          @map("barbershop_id") @db.Uuid
  orderId                  String          @map("order_id") @db.Uuid
  kind                     OrderItemKind   @default(SERVICE)
  /// Exatamente um de serviceId/productId/packageId, conforme o kind (CHECK na migration).
  serviceId                String?         @map("service_id") @db.Uuid
  productId                String?         @map("product_id") @db.Uuid
  /// Pacote vendido neste item (kind PACKAGE).
  packageId                String?         @map("package_id") @db.Uuid
  /// Serviço pago com sessão de pacote do cliente: cobra zero, comissão sobre o valor da sessão.
  clientPackageId          String?         @map("client_package_id") @db.Uuid
  /// Valor da sessão do pacote (snapshot no fechamento): base da comissão do item.
  packageSessionValueCents Int?            @map("package_session_value_cents")
  /// Obrigatório em serviço; opcional em produto (venda de balcão, sem comissão).
  professionalId           String?         @map("professional_id") @db.Uuid
  name                     String
  unitPriceCents           Int             @map("unit_price_cents")
  quantity                 Int             @default(1)
  discountCents            Int             @default(0) @map("discount_cents")
  /// unitPrice × quantidade − desconto
  totalCents               Int             @map("total_cents")
  commissionType           CommissionType? @map("commission_type")
  commissionValue          Int?            @map("commission_value")
  commissionCents          Int?            @map("commission_cents")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz

  order         Order           @relation(fields: [barbershopId, orderId], references: [barbershopId, id], onDelete: Cascade, map: "order_items_tenant_order_fkey")
  service       Service?        @relation(fields: [barbershopId, serviceId], references: [barbershopId, id], map: "order_items_tenant_service_fkey")
  product       Product?        @relation(fields: [barbershopId, productId], references: [barbershopId, id], map: "order_items_tenant_product_fkey")
  package       ServicePackage? @relation(fields: [barbershopId, packageId], references: [barbershopId, id], map: "order_items_tenant_package_fkey")
  clientPackage ClientPackage?  @relation(fields: [barbershopId, clientPackageId], references: [barbershopId, id], map: "order_items_tenant_client_package_fkey")
  professional  Membership?     @relation(fields: [barbershopId, professionalId], references: [barbershopId, id], map: "order_items_tenant_professional_fkey")

  @@unique([barbershopId, id], map: "order_items_tenant_id_key")
  @@index([barbershopId, orderId])
  @@map("order_items")
}

enum EntryKind {
  ENTRY
  REVERSAL
  /// Reembolso de pacote pago antecipadamente (business-rules §6).
  REFUND
}

/// Lançamento de comissão. Append-only: estorno gera lançamento negativo.
model CommissionEntry {
  id             String    @id @default(uuid(7)) @db.Uuid
  barbershopId   String    @map("barbershop_id") @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  orderItemId    String    @map("order_item_id") @db.Uuid
  professionalId String    @map("professional_id") @db.Uuid
  kind           EntryKind
  amountCents    Int       @map("amount_cents")
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz

  order        Order      @relation(fields: [barbershopId, orderId], references: [barbershopId, id], map: "commission_entries_tenant_order_fkey")
  professional Membership @relation(fields: [barbershopId, professionalId], references: [barbershopId, id], map: "commission_entries_tenant_professional_fkey")

  @@index([barbershopId, professionalId, occurredAt])
  @@map("commission_entries")
}

/// Lançamento de caixa. Append-only: estorno gera lançamento negativo.
model CashEntry {
  id           String        @id @default(uuid(7)) @db.Uuid
  barbershopId String        @map("barbershop_id") @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  method       PaymentMethod
  kind         EntryKind
  amountCents  Int           @map("amount_cents")
  occurredAt   DateTime      @default(now()) @map("occurred_at") @db.Timestamptz

  order Order @relation(fields: [barbershopId, orderId], references: [barbershopId, id], map: "cash_entries_tenant_order_fkey")

  @@index([barbershopId, occurredAt])
  @@map("cash_entries")
}

// ───────────── Aniversários e campanhas (business-rules §9) ─────────────

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MarketingMessageKind {
  BIRTHDAY
  CAMPAIGN
}

enum MarketingMessageStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

/// Conta do WhatsApp Business da barbearia (Cloud API da Meta), conectada manualmente.
model WhatsAppConnection {
  id                 String   @id @default(uuid(7)) @db.Uuid
  barbershopId       String   @unique @map("barbershop_id") @db.Uuid
  phoneNumberId      String   @map("phone_number_id")
  businessAccountId  String   @map("business_account_id")
  /// Conferidos na Meta ao conectar; mostrados no painel.
  displayPhoneNumber String   @map("display_phone_number")
  verifiedName       String   @map("verified_name")
  /// Token de acesso cifrado (AES-256-GCM, ligado ao tenant). Nunca sai da API.
  accessTokenSealed  String   @map("access_token_sealed")
  connectedByUserId  String   @map("connected_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade, map: "whatsapp_connections_barbershop_fkey")

  @@unique([barbershopId, id], map: "whatsapp_connections_tenant_id_key")
  @@map("whatsapp_connections")
}

/// Envio em massa para um público filtrado. Imutável depois de criada.
model Campaign {
  id               String         @id @default(uuid(7)) @db.Uuid
  barbershopId     String         @map("barbershop_id") @db.Uuid
  name             String
  channel          MessageChannel
  /// Filtro usado ({ kind: 'inactive', days } …), guardado para o histórico.
  audience         Json
  emailSubject     String?        @map("email_subject")
  emailBody        String?        @map("email_body")
  /// Modelo aprovado do WhatsApp ({ name, language, parameters }).
  whatsappTemplate Json?          @map("whatsapp_template")
  recipientCount   Int            @map("recipient_count")
  createdByUserId  String         @map("created_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  barbershop Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade, map: "campaigns_barbershop_fkey")
  messages   MarketingMessage[]

  @@unique([barbershopId, id], map: "campaigns_tenant_id_key")
  @@index([barbershopId, createdAt])
  @@map("campaigns")
}

/// Uma mensagem para um cliente (aniversário ou campanha), despachada pelo outbox.
model MarketingMessage {
  id                String                 @id @default(uuid(7)) @db.Uuid
  barbershopId      String                 @map("barbershop_id") @db.Uuid
  clientId          String                 @map("client_id") @db.Uuid
  kind              MarketingMessageKind
  channel           MessageChannel
  status            MarketingMessageStatus @default(PENDING)
  /// Só em campanha.
  campaignId        String?                @map("campaign_id") @db.Uuid
  /// Só em aniversário: no máximo uma mensagem por cliente por ano (índice único).
  birthdayYear      Int?                   @map("birthday_year")
  /// Motivo de SKIPPED/FAILED, em código curto e sem dado pessoal (ex.: no-consent).
  outcome           String?
  /// ID da mensagem no provedor (e-mail ou WhatsApp), quando enviada.
  providerMessageId String?                @map("provider_message_id")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  sentAt            DateTime?              @map("sent_at") @db.Timestamptz

  client   Client    @relation(fields: [barbershopId, clientId], references: [barbershopId, id], map: "marketing_messages_tenant_client_fkey")
  campaign Campaign? @relation(fields: [barbershopId, campaignId], references: [barbershopId, id], map: "marketing_messages_tenant_campaign_fkey")

  @@unique([barbershopId, id], map: "marketing_messages_tenant_id_key")
  @@unique([barbershopId, clientId, birthdayYear], map: "marketing_messages_birthday_key")
  @@unique([campaignId, clientId], map: "marketing_messages_campaign_client_key")
  @@index([barbershopId, campaignId])
  @@map("marketing_messages")
}

/// Plano de assinatura (business-rules §12). Catálogo global da plataforma, sem tenant: a
/// aplicação só lê. Plano novo ou mudança de conteúdo é dado (por migration, por enquanto).
model Plan {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Identificador estável para seed e integrações. O código checa recursos, nunca a chave.
  key       String   @unique
  name      String
  /// Chaves do catálogo FEATURES (subscriptions/features.ts). Chave desconhecida é ignorada.
  features  String[]
  /// Ordem de exibição, do mais básico ao mais completo.
  position  Int      @unique
  /// Plano de quem cria uma barbearia. No máximo um (constraint no SQL manual).
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Assinatura da barbearia: uma por tenant. Trocar de plano nunca apaga dados (§12).
model Subscription {
  id           String             @id @default(uuid(7)) @db.Uuid
  barbershopId String             @unique @map("barbershop_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade, map: "subscriptions_barbershop_fkey")
  plan       Plan       @relation(fields: [planId], references: [id], map: "subscriptions_plan_fkey")

  @@unique([barbershopId, id], map: "subscriptions_tenant_id_key")
  @@map("subscriptions")
}
