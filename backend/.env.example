NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# Usuário da aplicação (sem ownership, sujeito ao RLS)
DATABASE_URL=postgresql://tanaregua_app:tanaregua_app@db:5432/tanaregua
# Usuário dono das tabelas, usado só pelo CLI do Prisma (migrations/seed)
DATABASE_MIGRATION_URL=postgresql://tanaregua:tanaregua@db:5432/tanaregua

# Segredo do access token (mínimo 32 caracteres; gere com `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# URL pública do frontend (links em e-mails)
APP_PUBLIC_URL=http://localhost:3000

# Telemetria (OpenTelemetry). Sem endpoint, os traces não são exportados.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# E-mail: "log" escreve no console (dev); "resend" envia de verdade
MAIL_PROVIDER=log
MAIL_FROM=TaNaRegua <nao-responda@tanaregua.local>
RESEND_API_KEY=

# Arquivos enviados (logos): "local" grava em disco (em produção, um volume)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Número de proxies confiáveis à frente da API (0 em dev; 1 atrás de um load balancer)
TRUST_PROXY_HOPS=0

# Só para o E2E local (muitos cadastros do mesmo IP). Nunca false em produção.
RATE_LIMIT_ENABLED=true
