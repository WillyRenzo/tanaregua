NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# Usuário da aplicação (sem ownership, sujeito ao RLS)
DATABASE_URL=postgresql://tanaregua_app:tanaregua_app@db:5432/tanaregua
# Usuário dono das tabelas, usado só pelo CLI do Prisma (migrations/seed)
DATABASE_MIGRATION_URL=postgresql://tanaregua:tanaregua@db:5432/tanaregua

# Segredo do access token (mínimo 32 caracteres; gere com `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Segredo do access token da administração da plataforma (/admin: planos e preços).
# Diferente do JWT_ACCESS_SECRET. Sem ele a administração fica desligada (404); em dev o
# docker-compose.yml já define um. Obrigatório em produção.
PLATFORM_JWT_SECRET=

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# URL pública do frontend (links em e-mails)
APP_PUBLIC_URL=http://localhost:3000

# Telemetria (OpenTelemetry). Sem endpoint, os traces não são exportados.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# E-mail: "log" escreve no console (dev); "resend" envia de verdade
MAIL_PROVIDER=log
MAIL_FROM=TaNaRegua <nao-responda@tanaregua.local>
RESEND_API_KEY=

# WhatsApp (Cloud API da Meta): "log" simula o envio (dev); "meta" envia de verdade.
# Cada barbearia conecta a própria conta no painel; a versão da Graph API é configurável.
WHATSAPP_PROVIDER=log
META_GRAPH_API_VERSION=v23.0

# Chave que cifra segredos de terceiros no banco (token do WhatsApp de cada barbearia).
# Base64 de 32 bytes: `openssl rand -base64 32`. Obrigatória em produção; trocar a chave
# exige reconectar o WhatsApp das barbearias.
SECRETS_ENCRYPTION_KEY=

# Arquivos enviados (logos): "local" grava em disco (em produção, um volume)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Número de proxies confiáveis à frente da API que preenchem o X-Forwarded-For.
# 0 em dev; 1 em produção (o Caddy grava o IP do visitante; o Next só repassa).
# Em produção a API recusa subir com 0.
TRUST_PROXY_HOPS=0

# Segredo do SSR do Next (cabeçalho x-internal-token): tira as chamadas do servidor do
# Next do rate limit por IP. O mesmo valor vai no INTERNAL_API_TOKEN do frontend.
# Mínimo 32 caracteres (`openssl rand -base64 48`). Obrigatória em produção.
INTERNAL_API_TOKEN=

# Só para o E2E local (muitos cadastros do mesmo IP). Nunca false em produção.
RATE_LIMIT_ENABLED=true
